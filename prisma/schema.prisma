// Modelo de dados do v1 — ver docs/PRD.md secao 5.
// Workspace e BrandKit ja existem como tabelas separadas mesmo com uma linha so hoje,
// para nao exigir migracao estrutural se/quando o produto virar multi-tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String     @id @default(cuid())
  nome      String
  criadoEm  DateTime   @default(now())
  brandKit  BrandKit?
  posts     PostGerado[]

  /// Foco editorial por abrangência — ex.: [{escopo: "nova-serrana", editoriasPrioritarias: ["politica","saude","cultura"]}].
  /// Formato validado em src/lib/domain/linhaEditorial.ts. Usado pra pontuar
  /// pauta no radar: fora do foco declarado pontua baixo mesmo sendo "notícia"
  /// em tese. JSON em vez de tabela própria — é config de leitura simples, sem
  /// necessidade de query relacional nem tela de edição ainda.
  linhaEditorial Json?

  @@map("workspace")
}

model BrandKit {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String    @unique

  corAzul   String
  corPreto  String
  corBranco String
  corCinza  String

  logoPositivoSvg String @db.Text
  logoNegativoSvg String @db.Text
  aspaSvg         String @db.Text

  fonteManchetefoto String // ex.: "Archivo Black"
  fonteRotulo       String // ex.: "Noto Sans"
  fonteManchetecard String // ex.: "Noto Serif"

  atualizadoEm DateTime @updatedAt

  @@map("brand_kit")
}

/// Tipo de template — o "layout" da peça (não confundir com Tamanho).
enum TipoTemplate {
  foto
  card
}

/// Tamanho de saída — o que Instagram chama de posicionamento. Eixo
/// independente do TipoTemplate: qualquer TipoTemplate pode sair em
/// qualquer Tamanho.
enum Tamanho {
  feed
  stories
}

enum TemaPost {
  claro
  escuro
}

model PostGerado {
  id          String      @id @default(cuid())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  workspaceId String

  tipo          TipoTemplate
  tamanho       Tamanho      @default(feed)
  tagOuRotulo   String
  manicheteRaw  String      @db.Text // texto com a sintaxe **destaque** preservada
  tema          TemaPost? // só usado quando tipo = card
  imagemOrigemUrl  String? // upload usado como fundo, só quando tipo = foto
  imagemResultadoUrl String // arquivo final, guardado no R2

  criadoEm DateTime @default(now())

  @@map("post_gerado")
  @@index([workspaceId, criadoEm])
}

/// Como o conteúdo de uma Fonte é obtido e comparado com a última checagem.
/// api_json: dados abertos estruturados (ex.: portal da prefeitura) — sem
///   scraping, diffing por chave (nº de edição, id de processo etc.).
/// manual: sem automação ainda (ex.: redes sociais de concorrentes,
///   bloqueadas pra scraping) — existe só como registro no radar.
enum EstrategiaFonte {
  api_json
  manual
}

model Fonte {
  id          String          @id @default(cuid())
  nome        String
  categoria   String          // rótulo livre pro filtro na UI: "diario-oficial" | "licitacoes" | "imprensa" etc.
  escopo      String          // chave que casa com linhaEditorial.escopo no Workspace — ex.: "nova-serrana" | "nacional".
  estrategia  EstrategiaFonte
  urlApi      String?         // endpoint de dados abertos, só quando estrategia = api_json
  urlPagina   String          // página pública equivalente, usada no link "abrir fonte"
  ativo       Boolean         @default(true)
  criadoEm    DateTime        @default(now())
  pautas      Pauta[]

  @@unique([categoria])
  @@map("fonte")
}

enum StatusPauta {
  pendente
  apuracao
  dispensada
}

model Pauta {
  id           String      @id @default(cuid())
  fonte        Fonte       @relation(fields: [fonteId], references: [id])
  fonteId      String
  chaveExterna String      // identificador da fonte de origem (nº de edição, id de processo) — evita duplicar em novas checagens
  titulo       String
  resumo       String?     @db.Text
  urlOrigem    String
  publicadoEm  DateTime?
  descobertoEm DateTime    @default(now())
  status       StatusPauta @default(pendente)

  // Classificação automática (Haiku) — ver src/lib/radar/classificar.ts.
  pontuacao          Int?        // 0-10, soma da régua em src/lib/domain/classificacaoPauta.ts
  categorias         String[]    @default([]) // editorias que a IA identificou (ex.: ["saude"])
  justificativaIA    String?     @db.Text
  descarteAutomatico Boolean     @default(false) // true = status=dispensada decidido pela pontuação, não por você

  apuracao Apuracao?

  @@unique([fonteId, chaveExterna])
  @@index([fonteId, status])
  @@map("pauta")
}

/// Sala de apuração — ver docs/PRD.md seção 10. Criada quando uma Pauta
/// muda pra status "apuracao". Substitui o dossiê em Markdown do
/// repositório `replica`: o dossie aqui É o registro permanente.
model Apuracao {
  id           String   @id @default(cuid())
  pauta        Pauta    @relation(fields: [pautaId], references: [id])
  pautaId      String   @unique
  dossie       String   @db.Text @default("")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  fontes    FonteApuracao[]
  mensagens MensagemApuracao[]

  @@map("apuracao")
}

enum TipoFonteApuracao {
  link
  arquivo
  nota
}

/// Fonte anexada na sala — o campo `tipo` é o que preserva a distinção
/// entre fonte verificável (link, arquivo) e informação solta sem
/// documento formal (nota), regra já em vigor no repo `replica`: não
/// publicar fato sem fonte registrada.
model FonteApuracao {
  id         String            @id @default(cuid())
  apuracao   Apuracao          @relation(fields: [apuracaoId], references: [id])
  apuracaoId String
  tipo       TipoFonteApuracao
  conteudo   String            @db.Text // URL (link) ou o texto da nota (nota); vazio quando tipo=arquivo
  arquivoUrl String? // só quando tipo = arquivo, sobe pro R2
  descricao  String?
  criadoEm   DateTime          @default(now())

  @@index([apuracaoId])
  @@map("fonte_apuracao")
}

enum PapelMensagem {
  usuario
  agente
}

model MensagemApuracao {
  id         String        @id @default(cuid())
  apuracao   Apuracao      @relation(fields: [apuracaoId], references: [id])
  apuracaoId String
  papel      PapelMensagem
  conteudo   String        @db.Text
  criadoEm   DateTime      @default(now())

  @@index([apuracaoId, criadoEm])
  @@map("mensagem_apuracao")
}
