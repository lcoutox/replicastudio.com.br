# Postgres (Railway provisiona isso automaticamente ao criar o serviço de banco)
DATABASE_URL="postgresql://user:password@host:5432/replica_studio"

# Gate de login do v1 — usuário único, sem tabela de usuários.
APP_PASSWORD="troque-isto"
# Chave usada só pra assinar o cookie de sessão (qualquer string longa e aleatória serve).
SESSION_SECRET="troque-isto-tambem"

# Cloudflare R2 (compatível com S3) — onde as imagens geradas ficam guardadas.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="replica-studio-posts"
# URL pública do bucket (domínio customizado ou o dev URL que o R2 fornece).
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
